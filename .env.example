# Gemini AI API Key
# Get your free API key from: https://aistudio.google.com/app/apikey
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy the key and paste it below
GEMINI_API_KEY=your_api_key_here

# Flask Debug Mode (set to 'false' for production)
# NEVER set this to 'true' in production - exposes stack traces and enables code reloading
FLASK_DEBUG=false

# Flask Secret Key (for session management and CSRF protection)
# Generate with: python -c "import os; print(os.urandom(24).hex())"
# In production, set this to a secure random value
SECRET_KEY=your_secret_key_here

# Gemini model to use. Check what your key can access with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# Current stable Flash models include gemini-3.8-flash, gemini-3.7-flash and
# gemini-3.6-flash; gemini-flash-latest always points at the newest Flash release.
GEMINI_MODEL=gemini-flash-latest

# Timeout (in milliseconds) applied to each Gemini request
GEMINI_TIMEOUT_MS=30000
